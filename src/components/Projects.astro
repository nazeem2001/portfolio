              {project.technologies.map((tech) => (
                <li>{tech}</li>
              ))}
            </ul>
            <div class="project-links">
              {project.githubLink && (
                <a href={project.githubLink} target="_blank" class="button">
                  GitHub
                </a>
              )}
            </div>
