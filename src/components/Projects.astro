              <h5>Description:</h5>
              <ul class="technologies">
                {project.description.map((desc) => (
                  <li>{desc}</li>
                ))}
              </ul>
            ) : (
              <p>{project.description}</p>
            )}
            {Array.isArray(project.description) && <h5>Technologies:</h5>}
